---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.png';
import Icon from '../components/Icon.astro';
import PostList from '../components/PostList.astro';
import Layout from '../layouts/Layout.astro';
import { age, tenure } from '../lib/age';
import { getPosts } from '../lib/posts';
import { PROJECTS, SITE } from '../lib/site';

const latest = (await getPosts()).slice(0, 5);
const now = new Date();
---

<Layout>
  <Fragment slot="rail">
    <section class="panel profile" aria-label="Profile">
      <Image src={avatar} alt="The letters ahl drawn in ASCII characters" width={112} height={112} densities={[1, 2]} />
      <div>
        <h1 class="profile-name">{SITE.name}</h1>
        <p class="meta">@{SITE.handle}</p>
      </div>
      <ul class="facts">
        <li><Icon name="lucide:map-pin" size={16} />{SITE.location}</li>
        <li><Icon name="lucide:briefcase" size={16} />Software Engineer</li>
      </ul>
    </section>

    <section class="panel" aria-labelledby="links-title">
      <h2 class="panel-title" id="links-title"><Icon name="lucide:link" />Links</h2>
      <ul class="facts">
        <li>
          <Icon name="simple-icons:github" size={16} />
          <a href={SITE.github}>GitHub</a>
          <span class="meta">@{SITE.handle}</span>
        </li>
        <li>
          <Icon name="lucide:rss" size={16} />
          <a href="/rss.xml">RSS feed</a>
        </li>
      </ul>
    </section>
  </Fragment>

  <section class="panel" aria-labelledby="about-title">
    <h2 class="panel-title" id="about-title"><Icon name="lucide:user" />About</h2>
    <div class="about">
      <p>
        I'm Alex, <span data-calc="age">{age(now)}</span>. I've been working as a fullstack developer for{' '}
        <span data-calc="tenure">{tenure(now)}</span>.
      </p>
      <p>Outside of work I make side projects, mostly related to video games.</p>
      <p>This site is also where I write down how my own machine is set up.</p>
    </div>
  </section>

  <section class="panel" aria-labelledby="posts-title">
    <h2 class="panel-title" id="posts-title"><Icon name="lucide:notebook-pen" />Latest posts</h2>
    <PostList posts={latest} />
    <a class="more" href="/blog/">All posts <Icon name="lucide:arrow-right" size={14} /></a>
  </section>

  <section class="panel" aria-labelledby="projects-title">
    <h2 class="panel-title" id="projects-title"><Icon name="lucide:folder-git-2" />Projects</h2>
    <ul class="post-list">
      {
        PROJECTS.map((project) => (
          <li>
            <div class="post-row">
              <a class="post-row-title" href={project.url}>
                {project.name}
              </a>
              <p>{project.note}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<script>
  import { age, tenure } from '../lib/age';

  // the build-time values go stale between deploys; refresh them on load
  const values: Record<string, string> = { age: String(age()), tenure: tenure() };
  for (const el of document.querySelectorAll<HTMLElement>('[data-calc]')) {
    el.textContent = values[el.dataset.calc ?? ''] ?? el.textContent;
  }
</script>

<style>
  .profile {
    display: grid;
    gap: 1rem;
  }

  .profile img {
    width: 112px;
    height: 112px;
    border: 1px solid var(--line);
    image-rendering: auto;
  }

  .profile-name {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .facts {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.625rem;
    font-size: 0.9375rem;
  }

  .facts li {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .facts .icon {
    color: var(--red);
  }

  .about {
    display: grid;
    gap: 0.75rem;
    max-width: var(--measure);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1.25rem;
    font-family: var(--mono);
    font-size: 0.875rem;
  }
</style>
