---
import '../../styles/prose.css';
import { render } from 'astro:content';
import Icon from '../../components/Icon.astro';
import Layout from '../../layouts/Layout.astro';
import { formatDate, getPosts, getSeries, type Post, readingMinutes, tagHref } from '../../lib/posts';

export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate, updatedDate, tags, testedOn, draft } = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const series = await getSeries(post);
const current = series?.parts.findIndex((p) => p.current) ?? -1;
const prev = series && current > 0 ? series.parts[current - 1] : undefined;
const next = series && current >= 0 ? series.parts[current + 1] : undefined;
---

<Layout title={title} description={description} article={{ published: pubDate, modified: updatedDate, tags }}>
  {
    toc.length > 0 && (
      <details class="panel toc" slot="rail" open>
        <summary class="panel-title">
          <Icon name="lucide:list" />
          Contents
        </summary>
        <ol>
          {toc.map((h) => (
            <li class={`depth-${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ol>
      </details>
    )
  }

  <article class="panel article">
    <header class="article-header">
      <h1 class="article-title"><span>{title}</span></h1>
      <p class="meta article-meta">
        {draft && <span class="badge">draft</span>}
        <span>
          <Icon name="lucide:calendar" size={14} />
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        </span>
        {
          updatedDate && (
            <span>
              <Icon name="lucide:history" size={14} />
              updated <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time>
            </span>
          )
        }
        <span>
          <Icon name="lucide:clock" size={14} />
          {readingMinutes(post.body)} min read
        </span>
      </p>
      {
        tags.length > 0 && (
          <p class="article-tags">
            {tags.map((tag) => (
              <a class="tag" href={tagHref(tag)}>
                {tag}
              </a>
            ))}
          </p>
        )
      }

      {
        testedOn.length > 0 && (
          <div class="tested">
            <span class="tested-label">
              <Icon name="lucide:flask-conical" size={14} />
              tested on
            </span>
            <ul>
              {testedOn.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        )
      }

      {
        series && (
          <nav class="series" aria-label={`Series: ${series.name}`}>
            <p class="series-name">
              <Icon name="lucide:layers" size={16} />
              <span>
                Part {series.parts[current]?.part} of {series.parts.length} in <strong>{series.name}</strong>
              </span>
            </p>
            <ol>
              {series.parts.map((part) => (
                <li class:list={{ current: part.current }}>
                  <span class="meta">{String(part.part).padStart(2, '0')}</span>
                  {part.current ? (
                    <span aria-current="page">{part.title}</span>
                  ) : part.href ? (
                    <a href={part.href}>{part.title}</a>
                  ) : (
                    <span class="soon">
                      {part.title} <span class="meta">(coming soon)</span>
                    </span>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      (prev?.href || next?.href) && (
        <nav class="pager" aria-label="Series navigation">
          {prev?.href ? (
            <a class="pager-link" href={prev.href} rel="prev">
              <span class="meta">
                <Icon name="lucide:arrow-left" size={14} /> previous
              </span>
              <span>{prev.title}</span>
            </a>
          ) : (
            <span />
          )}
          {next?.href && (
            <a class="pager-link next" href={next.href} rel="next">
              <span class="meta">
                next <Icon name="lucide:arrow-right" size={14} />
              </span>
              <span>{next.title}</span>
            </a>
          )}
        </nav>
      )
    }
  </article>
</Layout>

<script>
  // collapse the contents on narrow screens, where the rail sits above the article
  const toc = document.querySelector<HTMLDetailsElement>('details.toc');
  const wide = window.matchMedia('(min-width: 64em)');
  if (toc) {
    toc.open = wide.matches;
    wide.addEventListener('change', (e) => (toc.open = e.matches));

    // mark the section currently being read
    const links = new Map(
      [...toc.querySelectorAll<HTMLAnchorElement>('a[href^="#"]')].map((a) => [decodeURIComponent(a.hash.slice(1)), a]),
    );
    const visible = new Set<string>();
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) visible.add(entry.target.id);
          else visible.delete(entry.target.id);
        }
        const active = [...links.keys()].find((id) => visible.has(id));
        if (!active) return;
        for (const [id, a] of links) a.toggleAttribute('aria-current', id === active);
      },
      { rootMargin: '0px 0px -70% 0px' },
    );
    for (const id of links.keys()) {
      const heading = document.getElementById(id);
      if (heading) observer.observe(heading);
    }
  }
</script>

<style>
  .toc summary {
    cursor: pointer;
    list-style: none;
    margin-bottom: 0;
  }

  .toc summary::-webkit-details-marker {
    display: none;
  }

  .toc[open] summary {
    margin-bottom: 1rem;
  }

  @media (min-width: 64em) {
    .toc summary {
      cursor: default;
      pointer-events: none;
    }
  }

  .toc ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.125rem;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .toc a {
    display: block;
    padding: 0.3125rem 0.5rem;
    color: var(--muted);
    text-decoration: none;
  }

  .toc .depth-3 a {
    padding-left: 1.25rem;
  }

  .toc a:hover {
    color: var(--fg);
    background: var(--raised);
  }

  .toc a[aria-current] {
    color: var(--panel);
    background: var(--fg);
  }

  .article {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
  }

  .article-header {
    display: grid;
    gap: 1rem;
  }

  /* the title is set like a terminal selection: foreground and background swapped */
  .article-title {
    font-size: clamp(1.75rem, 1.2rem + 2.2vw, 2.75rem);
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1.25;
    text-wrap: balance;
  }

  .article-title span {
    background: var(--fg);
    color: var(--panel);
    padding: 0.05em 0.3em;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  .article-meta,
  .article-meta span {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 1.25rem;
  }

  .article-meta span {
    gap: 0.375rem;
  }

  .article-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .tested {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--line);
    background: var(--raised);
    font-family: var(--mono);
    font-size: 0.8125rem;
  }

  .tested-label {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--green);
  }

  .tested ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.5rem;
  }

  .tested li + li::before {
    content: '·';
    color: var(--line-strong);
    margin-right: 0.5rem;
  }

  .series {
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 1rem;
    display: grid;
    gap: 0.75rem;
    font-size: 0.9375rem;
  }

  .series-name {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
  }

  .series-name .icon {
    color: var(--red);
  }

  .series-name strong {
    color: var(--fg);
    font-weight: 600;
  }

  .series ol {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.375rem;
  }

  .series li {
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .series li.current {
    color: var(--yellow);
  }

  .series .soon {
    color: var(--muted);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }

  .pager-link {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--line);
    color: var(--fg);
    text-decoration: none;
    transition: border-color 120ms ease-out, background-color 120ms ease-out;
  }

  .pager-link .meta {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
  }

  .pager-link:hover {
    border-color: var(--blue);
    background: var(--raised);
  }

  .pager-link.next {
    text-align: right;
    justify-items: end;
  }

  @media (max-width: 40em) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
